# ---- ClassConnect backend environment (placeholders only — copy to .env) ----

# Secret used to sign session tokens. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# MongoDB Atlas connection string. Never commit real credentials.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Local dev without Atlas (in-memory, data lost on restart): mongomock://local
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=classconnect

# The single college class this deployment serves (used by the roster import script)
CLASS_CODE=CSE-3B
CLASS_NAME=B.Tech CSE, Section B — Class of 2027

# File storage directory (files are stored on disk/object storage, NOT in MongoDB)
STORAGE_DIR=./var/uploads
MAX_UPLOAD_MB=25

# Comma-separated allowed browser origins for CORS (Vite dev server default shown)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP for password-reset emails. If unset, reset tokens are printed to
# the server console (development fallback only).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.edu
MAIL_USE_TLS=true

# Rate limiting (flask-limiter storage URI). Default in-memory is fine for one dyno;
# use redis://... when running multiple workers.
RATELIMIT_STORAGE_URI=memory://
